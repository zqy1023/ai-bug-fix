{
  "name": "ai-bug-fix-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node -e \"const fs=require('fs'),cp=require('child_process');if(!fs.existsSync('../app/workflow/frontend_contracts.py')){console.log('frontend_contracts: app/ unavailable, using committed workflow.generated.ts');process.exit(0)}const r=cp.spawnSync('python',['-m','app.workflow.frontend_contracts'],{cwd:'..',stdio:'inherit'});process.exit(r.status===0?0:1)\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^5.27.0",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
