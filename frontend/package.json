{
  "name": "ai-bug-fix-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node -e \"const fs=require('fs'),cp=require('child_process');if(!fs.existsSync('../workflow/engine/handoff.py')){console.log('frontend_contracts: workflow/ unavailable, using committed workflow.generated.ts');process.exit(0)}const r=cp.spawnSync('python',['-m','workflow.engine.handoff'],{cwd:'..',stdio:'inherit'});process.exit(r.status===0?0:1)\"",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
