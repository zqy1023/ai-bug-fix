# ========================================
# AI Bug Fixer 环境配置示例
# ========================================
# 复制此文件为 .env 并填写真实配置
# cp .env.example .env
#
# 应用默认值见 config/settings.py，Agent 默认值见各自目录的 config.json。
# 环境变量覆盖文件默认值；已设置的进程环境变量优先于 .env。


# ========================================
# ES 日志源配置（必填 LOG_ES）
# ========================================

# ES 集群地址
LOG_ES=http://your-elasticsearch-host:9200

# service.name 前缀，再精确匹配 service_name。
LOG_PULL_SERVICE_PREFIX=gather.py
LOG_PULL_SERVICE_NAME=gather.py.track

# 滚动拉取最近 N 小时的日志（不按日历零点截断）；留空使用 settings.default_log_hours
LOG_PULL_HOURS=

# 每次拉取日志的最大条数；0 表示不限
LOG_PULL_LIMIT=0

# 日志时区偏移（东八区 = 8）
LOG_PULL_TZ_OFFSET=8

# 业务错误过滤：这些错误不参与识别（JSON 数组或逗号分隔）
# JSON 格式示例：["Connection timeout", "Rate limit exceeded"]
# 逗号分隔示例：Connection timeout, Rate limit exceeded
LOG_PULL_IGNORE_ERRORS=[]

# 需要排除的业务类型（JSON 数组或逗号分隔）
LOG_PULL_EXCLUDED_BIZTYPES=["framework.controllers.cache_controller","framework.task_manager.result_sender"]

# 日志采集基础设施噪声：这些消息不来自 carrier 业务，直接排除
# 默认：["redis.exceptions.ConnectionError"]；设为 [] 表示不额外排除
LOG_PULL_EXCLUDED_MESSAGES=["redis.exceptions.ConnectionError"]

# ES 请求超时（秒）
ES_TIMEOUT_SECONDS=30

# ES 索引名前缀与日期格式（日期格式仅在 settings 中调整）
ES_INDEX_PREFIX=logstash-gather-

# ES 扫描批次大小与滚动上下文保留时长
ES_SCAN_SIZE=1000
ES_SCROLL=2m


# ========================================
# 源代码仓库配置（必填：URL 或本地路径二选一）
# ========================================

# 远程 Git 仓库地址（推荐）。配置后系统克隆到 <运行时目录>/source-repo，
# 每次运行前 fetch --prune，分支预检看到的是远端最新状态。
AI_REPAIR_SOURCE_URL=https://git.example.com/group/gather_spider_track.git
# HTTPS 凭据（私有仓库需要；SSH 地址留空，走 ssh-agent）
# 只存在于进程环境，不会写入镜像的 .git/config，也不会进入运行记录
# 不要把用户名/令牌直接写进 AI_REPAIR_SOURCE_URL
AI_REPAIR_GIT_USERNAME=
AI_REPAIR_GIT_PASSWORD=

# 项目子目录（相对于仓库根目录，gathers/、spiders/ 所在目录）
AI_REPAIR_PROJECT_SUBDIR=Src/gather_spider_track

# 可选：离线/本地开发时直接指定本地 Git 仓库路径。
# 设置 AI_REPAIR_SOURCE_URL 后本项被忽略。
# AI_REPAIR_SOURCE_REPO=D:\path\to\gather_spider_track

# 克隆与拉取源仓库的超时（秒）
AI_REPAIR_GIT_FETCH_TIMEOUT_SECONDS=300
# 首次克隆包含初始对象下载，使用独立的总超时
AI_REPAIR_GIT_CLONE_TIMEOUT_SECONDS=1800

# ========================================
# 运行数据配置
# ========================================

# 运行时数据目录（存放 runs、workspaces、source-repo 镜像、审计记录）
# 留空默认使用项目根目录下的 runtime/；如需固定位置可填绝对路径
AI_REPAIR_RUNTIME_DIR=

# 启动时回收可重建工作区，不删除 runs 审计记录
AI_REPAIR_WORKSPACE_GC_ENABLED=true
# 已终态执行的 shared/ai 工作区保留天数
AI_REPAIR_WORKSPACE_RETENTION_DAYS=7
# delivery/regression 临时克隆保留小时数
AI_REPAIR_DELIVERY_WORKSPACE_TTL_HOURS=24

# ========================================
# 验证命令配置
# ========================================

# 回归验证命令（JSON 数组格式）
# 以 py_compile 结尾的命令会自动追加本轮改动的 .py 文件；没有 .py 改动时自动跳过
# 示例 1：只做语法检查
AI_REPAIR_VERIFY_COMMANDS=[["python", "-m", "py_compile"]]

# 示例 2：语法检查 + 额外固定命令
# AI_REPAIR_VERIFY_COMMANDS=[["python", "-m", "py_compile"], ["pylint", "--errors-only"]]

# 示例 3：运行单元测试（固定命令，不会自动替换文件名）
# AI_REPAIR_VERIFY_COMMANDS=[["pytest", "tests", "-v"]]

# 单条固定验证命令的超时（秒）
AI_REPAIR_COMMAND_TIMEOUT_SECONDS=600

# response 重放超时（秒）
AI_REPAIR_REPLAY_TIMEOUT_SECONDS=30

# 重放业务代码用的 Python 解释器。必须是与线上环境一致、装有业务依赖
# (lxml/curl_cffi/httpx/yq_common 等) 的解释器，否则重放会在 import 阶段失败。
# 留空表示用当前解释器。
# 初始化（本地按线上同样的 Python 版本装业务依赖）：
#   python3.10 -m venv runtime/replay-venv
#   runtime/replay-venv/Scripts/python.exe -m pip install -r <业务仓库>/requirements.txt
# AI_REPAIR_REPLAY_PYTHON=D:\DXM\ai_bug_fixer\runtime\replay-venv\Scripts\python.exe

# 本地代理管理器地址（run_regression 必需）。08 准生产回归会向 server_dev.main
# 发送真实业务请求，代理未配置时该步骤直接失败（PROXY_MANAGER_ADDRESS_MISSING），
# 不会写入半生效的回归环境。
PROXY_MANAGER_ADDRESS=

# 准生产回归对账时豁免的运行时目录（逗号分隔）。main 初始化日志与 Nacos 本地缓存
# 是入口的正常行为；Git 状态行中的路径命中这些目录前缀即从对账中剔除。
# 默认 logs,nacos-data；受跟踪文件和其它新文件仍必须对账。
REGRESSION_RUNTIME_EXEMPT_DIRS=logs,nacos-data
# ========================================
# Git 配置
# ========================================

# Git 远程仓库名称
AI_REPAIR_GIT_REMOTE=origin

# 是否自动推送到远程（生产环境建议设为 false）
AI_REPAIR_GIT_PUSH=false

# 修复分支提交者身份。容器内没有全局 git config，缺身份时 git commit 直接失败；
# 默认 ai-bug-fixer / ai-bug-fixer@localhost，可按团队规范覆盖。
GIT_COMMITTER_NAME=ai-bug-fixer
GIT_COMMITTER_EMAIL=ai-bug-fixer@localhost
# ========================================
# 工作流配置
# ========================================

# 审查模式（agent = AI 审查, human = 人工审查）
AI_REPAIR_REVIEW_MODE=agent

# 每个任务的最大尝试次数
AI_REPAIR_MAX_ATTEMPTS=3

# 进程内常驻 Agent 会话上限
AI_REPAIR_MAX_SESSIONS=8

# Agent 进度输出与调试事件归档（true/false）
AI_REPAIR_PROGRESS=true
AI_REPAIR_DEBUG_HOOKS=true
# 调试事件归档路径；留空使用 settings.agent_archive_path
AI_REPAIR_DEBUG_HOOK_LOG=

# ========================================
# Claude Agent SDK 配置（必填）
# ========================================

# Claude API 认证 Token
ANTHROPIC_AUTH_TOKEN=sk-ant-xxxxx

# Claude API 基础 URL
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认模型
ANTHROPIC_MODEL=claude-opus-5-5

# Haiku 模型（快速任务）
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5

# Opus 模型（复杂任务）
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5

# Sonnet 模型（标准任务）
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5


# ========================================
# Agent 预算覆盖（可选）
# ========================================
# 默认值来自 app/agents/<agent>/config.json；
# 环境变量按字段覆盖，未设置时使用 JSON 配置。

# 定位 Agent（只读）
# AI_REPAIR_AGENT_LOCATE_CONFIG=app/agents/locate/config.json
# AI_REPAIR_AGENT_LOCATE_MAX_TURNS=14
# AI_REPAIR_AGENT_LOCATE_MAX_TOOL_CALLS=12
# AI_REPAIR_AGENT_LOCATE_MAX_CONTEXT_CHARS=50000
# AI_REPAIR_AGENT_LOCATE_MAX_CANDIDATE_FILES=6
# AI_REPAIR_AGENT_LOCATE_TIMEOUT_SECONDS=480

# 修复 Agent
# AI_REPAIR_AGENT_REPAIR_CONFIG=app/agents/repair/config.json
# AI_REPAIR_AGENT_REPAIR_ENABLED=true
# AI_REPAIR_AGENT_REPAIR_WRITABLE=true
# AI_REPAIR_AGENT_REPAIR_MAX_TURNS=16
# AI_REPAIR_AGENT_REPAIR_MAX_TOOL_CALLS=20
# AI_REPAIR_AGENT_REPAIR_MAX_CONTEXT_CHARS=18000
# AI_REPAIR_AGENT_REPAIR_MAX_CANDIDATE_FILES=6
# AI_REPAIR_AGENT_REPAIR_MAX_DIFF_CHARS=12000
# AI_REPAIR_AGENT_REPAIR_TIMEOUT_SECONDS=480

# 审查 Agent（只读）
# AI_REPAIR_AGENT_REVIEW_CONFIG=app/agents/review/config.json
# AI_REPAIR_AGENT_REVIEW_ENABLED=true
# AI_REPAIR_AGENT_REVIEW_MAX_TURNS=12
# AI_REPAIR_AGENT_REVIEW_MAX_TOOL_CALLS=16
# AI_REPAIR_AGENT_REVIEW_MAX_CONTEXT_CHARS=18000
# AI_REPAIR_AGENT_REVIEW_MAX_CANDIDATE_FILES=6
# AI_REPAIR_AGENT_REVIEW_MAX_DIFF_CHARS=12000
# AI_REPAIR_AGENT_REVIEW_TIMEOUT_SECONDS=480
# ========================================
# 工作台 API 配置
# ========================================

# 工作台 API 访问令牌，必须替换为随机长字符串
WORKBENCH_API_TOKEN=

# 未配置 WORKBENCH_API_TOKEN 时是否允许绑定非回环地址（0/1）。
# 默认关闭：未配 token 时启动会回落为只监听 127.0.0.1。
# 仅在明确知道"API 无鉴权"的后果时才置 1。
WORKBENCH_ALLOW_INSECURE=0

# 直接运行 python server.py 时的监听地址与端口
# Docker 部署由 docker-compose 固定为 0.0.0.0:8000
WORKBENCH_BIND_HOST=0.0.0.0
WORKBENCH_BIND_PORT=8000

# 允许跨域访问的来源（JSON 数组或逗号分隔）
WORKBENCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 工作台控制库连接等待与忙等待
WORKBENCH_SQLITE_TIMEOUT_SECONDS=10
WORKBENCH_SQLITE_BUSY_TIMEOUT_MS=10000

# 是否把完整提示词快照写入任务审计目录（1/0，默认开启）。
# 快照保留未脱敏原文，只落在任务级目录内；关闭后工作台不再能查看提示词内容。
WORKBENCH_PROMPT_SNAPSHOT=1
# ========================================
# Docker Compose 配置
# ========================================

# 持久化运行记录目录，必须 可由 APP_UID/APP_GID 写入
AI_REPAIR_RUNTIME_HOST_PATH=/absolute/host/path/to/ai-bug-tasks-runtime
# 镜像内 app 用户是 uid/gid 10001；默认与之一致，运行目录不必 chown。
APP_UID=10001
APP_GID=10001
# 前端 nginx 暴露到宿主机的端口
WORKBENCH_PORT=8080

# 工作区回收间隔（分钟→秒）。保留天数、交付工作区 TTL 与回收开关见
# 上方"运行目录与工作区策略"一节，那里是唯一定义处。
AI_REPAIR_WORKSPACE_GC_INTERVAL_SECONDS=3600
# compact：保留结论、Diff、验证证据、指标和恢复数据；debug 额外保存提示词和事件。
AI_REPAIR_ARTIFACT_MODE=compact
