# ========================================
# AI Bug Fixer 环境配置示例
# ========================================
# 复制此文件为 .env 并填写真实配置
# cp .env.example .env


# ========================================
# ES 日志源配置（必填）
# ========================================

# ES 集群地址
LOG_ES=http://your-elasticsearch-host:9200

# service.name 前缀，再精确匹配 service_name。
LOG_PULL_SERVICE_PREFIX=gather.py
LOG_PULL_SERVICE_NAME=gather.py.track

# 拉取最近 N 天的日志
LOG_PULL_DAYS=3

# 每次拉取日志的最大条数
LOG_PULL_LIMIT=100

# 日志时区偏移（东八区 = 8）
LOG_PULL_TZ_OFFSET=8

# 忽略的已知错误（JSON 数组或逗号分隔）
# JSON 格式示例：["Connection timeout", "Rate limit exceeded"]
# 逗号分隔示例：Connection timeout, Rate limit exceeded
LOG_PULL_IGNORE_ERRORS=[]


# ========================================
# 源代码仓库配置（必填）
# ========================================

# gather_spider_track 项目的根目录
AI_REPAIR_SOURCE_REPO=D:\path\to\gather_spider_track

# 项目子目录（相对于仓库根目录）
AI_REPAIR_PROJECT_SUBDIR=Src/gather_spider_track


# ========================================
# 工作区和输出配置
# ========================================

# 运行时数据目录（存放 runs、workspaces、审计记录）
AI_REPAIR_RUNTIME_DIR=D:\DXM\ai_bug_fixer\runtime

# 输出目录（报告、交付包）
OUTPUT_DIR=D:\DXM\ai_bug_fixer\output


# ========================================
# 验证命令配置
# ========================================

# 回归验证命令（JSON 数组格式）
# {file} 会被替换为实际文件路径
# 示例 1：只做语法检查
AI_REPAIR_VERIFY_COMMANDS=[["python", "-m", "py_compile", "{file}"]]

# 示例 2：多个验证命令
# AI_REPAIR_VERIFY_COMMANDS=[["python", "-m", "py_compile", "{file}"], ["pylint", "{file}"]]

# 示例 3：运行单元测试
# AI_REPAIR_VERIFY_COMMANDS=[["pytest", "tests/test_{carrier}.py", "-v"]]


# ========================================
# Git 配置
# ========================================

# Git 远程仓库名称
AI_REPAIR_GIT_REMOTE=origin

# 是否自动推送到远程（生产环境建议设为 false）
AI_REPAIR_GIT_PUSH=false


# ========================================
# 工作流配置
# ========================================

# 是否自动执行（false = 在关键点暂停等待确认）
AI_REPAIR_AUTORUN=false

# 审查模式（agent = AI 审查, human = 人工审查）
AI_REPAIR_REVIEW_MODE=agent

# 每个任务的最大尝试次数
AI_REPAIR_MAX_ATTEMPTS=3


# ========================================
# Claude Agent SDK 配置（必填）
# ========================================

# Claude API 认证 Token
ANTHROPIC_AUTH_TOKEN=sk-ant-xxxxx

# Claude API 基础 URL
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认模型
ANTHROPIC_MODEL=claude-opus-4-20250514

# Haiku 模型（快速任务）
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-3-5-haiku-20241022

# Opus 模型（复杂任务）
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-20250514

# Sonnet 模型（标准任务）
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-3-7-sonnet-20250219


# ========================================
# 可选配置
# ========================================

# ES 连接超时（秒）- 默认值在 config/settings.py 中定义
# ES_TIMEOUT_SECONDS=30

# ES 索引前缀 - 默认值在 config/settings.py 中定义
# ES_INDEX_PREFIX=yqtrack-gather-

# 默认输出目录 - 默认值在 config/settings.py 中定义
# DEFAULT_OUTPUT_DIR=./output

# 运行时目录名称 - 默认值在 config/settings.py 中定义
# RUNTIME_DIR_NAME=runtime

# Docker Compose：源仓库宿主机路径与容器内路径分开配置
AI_REPAIR_SOURCE_REPO_HOST_PATH=/absolute/host/path/to/gather_spider_track
# Docker Compose：持久化运行记录目录，必须可由 APP_UID/APP_GID 写入
AI_REPAIR_RUNTIME_HOST_PATH=/absolute/host/path/to/ai-repair-runtime
APP_UID=1000
APP_GID=1000
WORKBENCH_PORT=8080
# 工作台 API 访问令牌，必须替换为随机长字符串
WORKBENCH_API_TOKEN=replace-with-a-long-random-token
