# ==============================================================================
# AI Bug Fixer 极简环境配置 (.env)
# ==============================================================================
# 配置加载优先级：Nacos 配置中心 > 进程环境变量 / .env > config/settings.py 默认值
# 敏感凭证（Token/密码/连接串）建议配置在 Nacos 或本地 .env，严禁提交到 Git 仓库。

# 1. 大模型服务配置 (必填)
ANTHROPIC_AUTH_TOKEN=sk-ant-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5-5

# 2. ES 日志数据源配置 (必填)
LOG_ES=http://username:password@your-elasticsearch:9200
LOG_PULL_SERVICE_NAME=gather.py.track

# 3. 目标代码仓库 Git 配置 (必填)
AI_REPAIR_SOURCE_URL=https://git.example.com/group/gather_spider_track.git
AI_REPAIR_GIT_USERNAME=
AI_REPAIR_GIT_PASSWORD=
AI_REPAIR_PROJECT_SUBDIR=Src/gather_spider_track

# 4. Web 控制台访问安全 Token (对外部署必填；本地开发留空则默认仅监听 127.0.0.1)
WORKBENCH_API_TOKEN=
# 未配置 WORKBENCH_API_TOKEN 时是否允许绑定非回环地址 (1/0，默认关闭)。
# 默认关闭：启动会回落为只监听 127.0.0.1；仅在明确知道"API 无鉴权"的后果时置 1。
WORKBENCH_ALLOW_INSECURE=0
# 是否把完整提示词快照写入任务审计目录 (1/0，默认开启)。快照保留未脱敏原文，
# 只落在任务级目录内；关闭后工作台不再能查看提示词内容。
WORKBENCH_PROMPT_SNAPSHOT=1

# 5. Nacos 配置中心连接 (可选；若未启用或未安装则自动使用 .env 配置)
NACOS_ENABLED=true
NACOS_SERVER_ADDR=10.200.0.38:8848
NACOS_NAMESPACE=test-1
# Nacos 开启鉴权时填写
# NACOS_USERNAME=
# NACOS_PASSWORD=

# 模型网关 TLS 校验：仅内网证书过期时临时置 1，生产必须修证书并保持 0
CLAUDE_AGENT_INSECURE_TLS=0

# 6. 常见业务参数覆盖 (可选；未声明时系统默认自动使用 settings.py 内置规则)
# AI_REPAIR_REVIEW_MODE=agent     # agent (AI 审查) / human (标记人工复核，主图不等待审批)
# AI_REPAIR_MAX_ATTEMPTS=3        # 任务最大修复尝试总次数 (含首次)
# AI_REPAIR_GIT_PUSH=false        # 是否自动推送修复分支到远端 (生产建议 false)
# LOG_PULL_HOURS=24               # 日志滚动回溯小时数
# AI_REPAIR_PROMPT_PROFILE=slim   # slim(按需注入规则片段) / full(回退整份 common.md)
# PROXY_MANAGER_ADDRESS=          # 真实请求回归代理管理器地址

# 平台固定验证命令（可信运维配置，不接受模型或日志提供的命令）。
# replay/request 都是 argv 数组列表；每条命令必须包含 {input_path}。
# 未配置保持业务未验证，详见 docs/validation-runner.md。
# AI_REPAIR_VALIDATION_COMMANDS={"replay":[],"request":[],"timeout_seconds":60}
# 采集复现与回归使用独立 Python；留空使用平台解释器，须自行提供源项目运行依赖。
# AI_REPAIR_RUNTIME_PYTHON=D:/DXM/ai_bug_fixer/.runtime-venv/Scripts/python.exe
